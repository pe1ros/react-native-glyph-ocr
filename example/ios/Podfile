# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'GlyphOcrExample' do
  config = use_native_modules!

  # react-native-glyph-ocr with PaddleOCR on iOS (GlyphOcr_paddleOnIos=1 pod install): its Swift
  # imports ONNX Runtime's Objective-C API, which needs module maps.
  # The podspecs are copied from trunk into podspecs/: resolving the pods through the CocoaPods CDN
  # hangs on GitHub's macOS runners. An app only needs the `onnxruntime-objc` line.
  if ['1', 'true'].include?(ENV['GlyphOcr_paddleOnIos'].to_s)
    pod 'onnxruntime-objc', :modular_headers => true, :podspec => 'podspecs/onnxruntime-objc.podspec.json'
    pod 'onnxruntime-c', :podspec => 'podspecs/onnxruntime-c.podspec.json'
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
