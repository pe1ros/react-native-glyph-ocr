{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-glyph-ocr": ["./src/index"],
      "react-native-glyph-ocr/camera": ["./src/camera/index"],
      "react-native-glyph-ocr/dev": ["./src/dev/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "react-native-glyph-ocr-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["jest"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["lib", "plugin", "node_modules", "example/node_modules"]
}
