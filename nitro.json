{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["glyphocr"],
  "ios": {
    "iosModuleName": "NitroGlyphOcr"
  },
  "android": {
    "androidNamespace": ["glyphocr"],
    "androidCxxLibName": "NitroGlyphOcr"
  },
  "autolinking": {
    "GlyphOcrFactory": {
      "ios": { "language": "swift", "implementationClassName": "HybridGlyphOcrFactory" },
      "android": { "language": "kotlin", "implementationClassName": "HybridGlyphOcrFactory" }
    },
    "GlyphOcrDevTools": {
      "ios": { "language": "swift", "implementationClassName": "HybridGlyphOcrDevTools" },
      "android": { "language": "kotlin", "implementationClassName": "HybridGlyphOcrDevTools" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
