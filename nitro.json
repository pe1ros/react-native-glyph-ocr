{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["purelyocr"],
  "ios": {
    "iosModuleName": "NitroPurelyOcr"
  },
  "android": {
    "androidNamespace": ["purelyocr"],
    "androidCxxLibName": "NitroPurelyOcr"
  },
  "autolinking": {
    "OcrFactory": {
      "ios": { "language": "swift", "implementationClassName": "HybridOcrFactory" },
      "android": { "language": "kotlin", "implementationClassName": "HybridOcrFactory" }
    },
    "OcrDevTools": {
      "ios": { "language": "swift", "implementationClassName": "HybridOcrDevTools" },
      "android": { "language": "kotlin", "implementationClassName": "HybridOcrDevTools" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
