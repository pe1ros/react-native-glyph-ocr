{
  "name": "react-native-glyph-ocr",
  "version": "0.2.0",
  "private": true,
  "description": "On-device text recognition for React Native: Apple Vision on iOS, PaddleOCR (PP-OCRv5) on Android, as a Nitro module",
  "main": "src/index",
  "react-native": "src/index",
  "source": "src/index",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./camera": {
      "types": "./src/camera/index.ts",
      "react-native": "./src/camera/index.ts",
      "default": "./src/camera/index.ts"
    },
    "./dev": {
      "types": "./src/dev/index.ts",
      "react-native": "./src/dev/index.ts",
      "default": "./src/dev/index.ts"
    },
    "./models/manifest.json": "./models/manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "specs": "nitrogen --logLevel=\"debug\"",
    "manifest": "node scripts/build-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "nitrogen": "0.37.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.79",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-nitro-image": ">=0.15.2",
    "react-native-vision-camera": ">=5.2.3",
    "react-native-vision-camera-worklets": ">=5.2.3",
    "react-native-worklets": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-image": { "optional": true },
    "react-native-vision-camera": { "optional": true },
    "react-native-vision-camera-worklets": { "optional": true },
    "react-native-worklets": { "optional": true }
  }
}
